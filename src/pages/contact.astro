---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const contact = await getEntry('pages', 'contact');
const home = await getEntry('pages', 'home');
const profile = home!.data;
const { Content } = await render(contact!);
---
<Layout title={contact!.data.title} description={contact!.data.description} active="contact">
  <article class="article-page">
    <h1>{contact!.data.title}</h1>
    <div class="prose article-prose">
      {profile.email && <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>}
      {profile.github && <p><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></p>}
      {profile.links?.map(link => <p><a href={link.href}>{link.label}</a></p>)}
      <Content />
      {profile.cv && <p><a href={profile.cv} target="_blank" rel="noopener noreferrer">Download CV</a></p>}
    </div>
  </article>
</Layout>
